# Frankenstudio — required environment variables
# Copy to .env.local for local dev. Never commit .env.local or any .env file.

# ── LLM ─────────────────────────────────────────────────────────────────────
# Primary: DeepSeek (planner + writer)
DEEPSEEK_API_KEY=

# Secondary: critic vendor (e.g. Anthropic, OpenAI — any OpenAI-compatible endpoint)
CRITIC_API_KEY=
CRITIC_API_BASE_URL=
CRITIC_MODEL=

# ── Token budget (default 60k total per job) ──────────────────────────────
TOKEN_BUDGET=60000

# ── Storage ──────────────────────────────────────────────────────────────────
# Dev: leave blank — local filesystem under jobs/
# Prod: Vercel Blob write token
BLOB_READ_WRITE_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
# Dev: leave blank — SQLite file at jobs/frankenstudio.db
# Prod: Turso (libsql)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
